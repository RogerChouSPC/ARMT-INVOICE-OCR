# Copy this file to ".env" on the company server (next to docker-compose.yml).
# The .env file is gitignored — never commit real values.

# ── AI API (SECRET) ──────────────────────────────────────────────────────────
# Used by the server only. Keep this off GitHub and out of the Docker image.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Microsoft 365 / Azure AD Authentication (PUBLIC) ─────────────────────────
# 1. portal.azure.com → Azure Active Directory → App registrations → your app
# 2. Under Authentication, add Redirect URI (Web):
#       https://spc-ai.sahapat.com/armt-invoice-ocr/popup.html  (production)
#       http://localhost:5173/popup.html                      (local dev)
# 3. Copy Application (client) ID and Directory (tenant) ID below.
# These are baked into the browser bundle at build time — they are NOT secrets.
VITE_AZURE_CLIENT_ID=your-application-client-id-here
VITE_AZURE_TENANT_ID=your-directory-tenant-id-here

# ── Deploy path (PUBLIC) ───────────────────────────────────────────────────────
# Vite asset base path. Must match the Nginx location prefix (with trailing slash).
VITE_BASE_PATH=/armt-invoice-ocr/

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express server listens on inside the container (default 3000).
PORT=3000

# ── Background PDF jobs ─────────────────────────────────────────────────────
# Persistent job files inside the container. docker-compose.yml mounts the
# named armt-job-data volume at this path.
JOB_DATA_DIR=/app/job-data

# Number of large PDFs processed at once. Raising this increases RAM use and
# can increase the risk of OpenRouter rate-limit errors.
JOB_CONCURRENCY=1

# Maximum PDF pages rasterized in one bounded batch (hard limit: 10).
OCR_RENDER_BATCH_PAGES=10

# Remove completed/error job data after this many hours.
JOB_RETENTION_HOURS=24
