# Copy this file to ".env" on the company server (next to docker-compose.yml).
# The .env file is gitignored — never commit real values.

# ── AI API (SECRET) ──────────────────────────────────────────────────────────
# Used by the server only. Keep this off GitHub and out of the Docker image.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Microsoft 365 / Azure AD Authentication (PUBLIC) ─────────────────────────
# 1. portal.azure.com → Azure Active Directory → App registrations → your app
# 2. Under Authentication, add the new server's Redirect URI (Web):
#       https://your-company-domain/popup.html
#    Keep http://localhost:5173/popup.html for local development.
# 3. Copy Application (client) ID and Directory (tenant) ID below.
# These are baked into the browser bundle at build time — they are NOT secrets.
VITE_AZURE_CLIENT_ID=your-application-client-id-here
VITE_AZURE_TENANT_ID=your-directory-tenant-id-here

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express server listens on inside the container (default 3000).
PORT=3000
